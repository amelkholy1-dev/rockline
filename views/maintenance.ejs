<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>روك لاين جروب | تحت التطوير</title>
<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&family=Tajawal:wght@400;500;700&display=swap">
<style>
*{box-sizing:border-box} html,body{height:100%}
body{margin:0;font-family:"Tajawal","Segoe UI",system-ui,sans-serif;color:#e7ebf2;
  background:radial-gradient(85% 70% at 50% 0%,#2c4260 0%,#203145 50%,#152131 100%);
  display:grid;place-items:center;padding:28px;text-align:center;position:relative;overflow:hidden}
body::before,body::after{content:"";position:fixed;border-radius:50%;filter:blur(10px);opacity:.12;pointer-events:none;background:#b7a98e}
body::before{width:380px;height:380px;top:-130px;inset-inline-start:-110px}
body::after{width:340px;height:340px;bottom:-140px;inset-inline-end:-100px}
.box{position:relative;z-index:1;max-width:520px;width:100%}
.logo{display:block;width:min(260px,70vw);height:auto;margin:0 auto 26px}
.gear{width:64px;height:64px;margin:0 auto 20px;display:grid;place-items:center;border-radius:50%;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14)}
.gear svg{width:30px;height:30px;color:#ddd3bf;animation:sp 9s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.gear svg{animation:none}}
.badge{display:inline-block;font-family:"Cairo";font-weight:700;font-size:12.5px;letter-spacing:1px;color:#ddd3bf;
  background:rgba(183,169,142,.1);border:1px solid rgba(183,169,142,.35);border-radius:999px;padding:6px 15px;margin-bottom:20px}
h1{font-family:"Cairo";font-weight:900;font-size:36px;line-height:1.3;margin:0 0 14px;color:#f2f5fa}
p{color:#b8c2d2;font-size:17px;line-height:1.85;margin:0 auto;max-width:40ch}
.foot{margin-top:30px;color:#8994a8;font-size:13px}
@media(max-width:480px){h1{font-size:28px}p{font-size:15.5px}}
</style>
</head>
<body>
  <div class="box">
    <img class="logo" src="/img/logo-full-light.png" alt="Rock Line Group" width="260" height="131">
    <div class="gear" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3.2"/>
        <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.2 5.2l2.1 2.1M16.7 16.7l2.1 2.1M18.8 5.2l-2.1 2.1M7.3 16.7l-2.1 2.1"/>
      </svg>
    </div>
    <span class="badge">قيد التطوير</span>
    <h1>الموقع تحت التطوير</h1>
    <p>بنجهّز موقع روك لاين للتوريدات العامة وتجارة الحديد والأسمنت. قريباً إن شاء الله.</p>
    <div class="foot">© <%= year %> Rock Line Group · rocklineg.com</div>
  </div>
</body>
</html>
