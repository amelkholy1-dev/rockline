<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: tr(p.title), parent: ['/projects', t.nav_projects] }) %>
<% var imgs = p.images || []; var scope = tr(p.scope).split(/\n/).map(function(x){ return x.trim(); }).filter(Boolean); %>
<section class="sec">
  <div class="wrap job-grid">
    <article class="job-main reveal">
      <div class="pj-cover"><img src="<%= imgs[0] || img('project') %>" alt="<%= tr(p.title) %>"><span class="pc-status st-<%= p.status %>"><%= p.status === 'ongoing' ? t.status_ongoing : t.status_done %></span></div>
      <% if (tr(p.desc)) { %>
        <h2><%= t.p_about %></h2>
        <div class="prose"><% tr(p.desc).split(/\n/).forEach(function(l){ if (l.trim()) { %><p><%= l %></p><% } }); %></div>
      <% } %>
      <% if (scope.length) { %>
        <h2><%= t.p_scope %></h2>
        <ul class="checks"><% scope.forEach(function(s){ %><li><%- icon('checkcircle') %><%= s %></li><% }); %></ul>
      <% } %>
      <% if (imgs.length > 1) { %>
        <h2><%= t.p_gallery %></h2>
        <div class="pgrid" data-lightbox><% imgs.forEach(function(x){ %><a class="ph-it" href="<%= x %>" data-cap="<%= tr(p.title) %>"><img src="<%= x %>" alt="" loading="lazy"></a><% }); %></div>
      <% } %>
    </article>
    <aside class="job-side reveal">
      <div class="side-card">
        <dl class="job-facts col">
          <% if (p.cat) { %><div><dt><%- icon(catIcon(p.cat)) %><%= t.p_cat %></dt><dd><a href="<%= L('/projects?cat=' + encodeURIComponent(p.cat)) %>"><%= cat(p.cat) %></a></dd></div><% } %>
          <div><dt><%- icon('flag') %><%= t.p_status %></dt><dd><%= p.status === 'ongoing' ? t.status_ongoing : t.status_done %></dd></div>
          <% if (tr(p.client)) { %><div><dt><%- icon('handshake') %><%= t.p_client %></dt><dd><%= tr(p.client) %></dd></div><% } %>
          <% if (tr(p.location)) { %><div><dt><%- icon('map') %><%= t.p_location %></dt><dd><%= tr(p.location) %></dd></div><% } %>
          <% if (p.year) { %><div><dt><%- icon('calendar') %><%= t.p_year %></dt><dd dir="ltr"><%= p.year %></dd></div><% } %>
          <% if (p.area) { %><div><dt><%- icon('ruler') %><%= t.p_area %></dt><dd><%= p.area %></dd></div><% } %>
        </dl>
      </div>
      <div class="side-card">
        <h3><%= t.p_cta %></h3>
        <p class="muted"><%= t.p_cta_sub %></p>
        <a class="btn gold wide" href="<%= L('/quote?type=' + encodeURIComponent(cat(p.cat))) %>"><%- icon('doc') %> <%= t.cta_quote %></a>
        <button class="btn line-navy wide" type="button" data-share data-title="<%= tr(p.title) %>"><%- icon('copy') %> <%= t.share %></button>
      </div>
    </aside>
  </div>
  <% if (related.length) { %>
  <div class="wrap">
    <div class="shead"><h2><%= t.p_related %></h2><span class="rule"></span></div>
    <div class="proj-grid"><% related.forEach(function(x){ %><%- include('partials/projectcard', { p: x }) %><% }); %></div>
  </div>
  <% } %>
</section>
<%- include('partials/footer') %>
