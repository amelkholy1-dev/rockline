<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: t.projects, sub: t.projects_sub }) %>
<% function q(c, s) { var p = []; if (c) p.push('cat=' + encodeURIComponent(c)); if (s) p.push('status=' + s); return L('/projects' + (p.length ? '?' + p.join('&') : '')); } %>
<section class="sec">
  <div class="wrap">
    <div class="pfilter" role="navigation" aria-label="<%= t.p_status %>">
      <div class="seg">
        <a href="<%= q(catQ, '') %>" class="<%= !status ? 'on' : '' %>"><%= t.all_status %> <i><%= total %></i></a>
        <a href="<%= q(catQ, 'done') %>" class="<%= status === 'done' ? 'on' : '' %>"><%= t.status_done %> <i><%= counts.done %></i></a>
        <a href="<%= q(catQ, 'ongoing') %>" class="<%= status === 'ongoing' ? 'on' : '' %>"><%= t.status_ongoing %> <i><%= counts.ongoing %></i></a>
      </div>
      <% if (cats.length > 1) { %>
      <div class="chips">
        <a class="chip<%= !catQ ? ' on' : '' %>" href="<%= q('', status) %>"><%= t.all_cats %></a>
        <% cats.forEach(function(c){ %><a class="chip<%= c === catQ ? ' on' : '' %>" href="<%= q(c, status) %>"><%- icon(catIcon(c)) %> <%= cat(c) %></a><% }); %>
      </div>
      <% } %>
    </div>
    <% if (list.length) { %>
      <div class="proj-grid"><% list.forEach(function(p){ %><%- include('partials/projectcard', { p: p }) %><% }); %></div>
    <% } else { %>
      <div class="empty"><%- icon('building') %><p><%= t.no_projects %></p><a class="btn line-navy" href="<%= L('/projects') %>"><%= t.clear %></a></div>
    <% } %>
  </div>
</section>
<%- include('partials/cta') %>
<%- include('partials/footer') %>
