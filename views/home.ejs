<%- include('partials/head') %>
<%- include('partials/header') %>
<% var arrow = icon(lang === 'ar' ? 'arrow' : 'arrowr'); %>

<% var stats = (site.stats || []).filter(function(s){ return s.value; }); %>
<%- include('partials/hero/' + theme, { arrow: arrow, stats: stats }) %>

<%- include('partials/customs', { pos: 'after_hero' }) %>

<section class="sec ab-sec" id="about">
  <div class="wrap ab-grid">
    <div class="ab-ph reveal">
      <img src="<%= img('about') %>" alt="" loading="lazy" width="600" height="480">
      <% if (stats[0]) { %><div class="ab-yrs"><b><%= stats[0].value %></b><%= tr(stats[0].label) %></div><% } %>
    </div>
    <div class="ab-tx reveal">
      <span class="kick"><%= t.about_title %></span>
      <h2><%= tr(site.brand.name) %></h2>
      <p><%= tr(site.about.p1) %></p>
      <p><%= tr(site.about.p2) %></p>
      <ul class="ab-chk"><% (site.why || []).slice(0, 4).forEach(function(w){ %><li><%- icon('checkcircle') %><%= tr(w.text) %></li><% }); %></ul>
      <a class="btn navy" href="<%= L('/about') %>"><%= t.more %> <%- arrow %></a>
    </div>
  </div>
</section>

<%- include('partials/customs', { pos: 'after_about' }) %>

<section class="sec sky sv-sec" id="services">
  <div class="wrap">
    <div class="shx reveal"><div><span class="kick"><%= t.services %></span><h2><%= t.services_sub %></h2></div><a class="btn navy" href="<%= L('/services') %>"><%= t.view_all %> <%- arrow %></a></div>
    <div class="sv-g">
      <% (site.services || []).forEach(function(s, i){ %>
        <article class="sv reveal">
          <img class="sv-img" src="<%= svcImg(i) %>" alt="" loading="lazy">
          <span class="sv-n"><%= String(i + 1).padStart(2, '0') %></span>
          <span class="sv-ic"><%- icon(s.icon) %></span>
          <div class="sv-tx"><h3><%= tr(s.title) %></h3><p><%= tr(s.desc) %></p></div>
          <a class="sv-ar" href="<%= L('/quote') %>" aria-label="<%= t.cta_quote %>"><%- arrow %></a>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<% if (projects.length) { %>
<section class="sec pj-sec" id="products">
  <div class="wrap">
    <div class="shx reveal"><div><span class="kick"><%= t.nav_products %></span><h2><%= t.featured_products %></h2></div><a class="btn line-gold" href="<%= L('/products') %>"><%= t.view_all %> (<%= projectsCount %>) <%- arrow %></a></div>
    <div class="proj-grid"><% projects.forEach(function(p){ %><%- include('partials/productcard', { p: p }) %><% }); %></div>
  </div>
</section>
<% } %>

<section class="sec sky" id="process">
  <div class="wrap">
    <div class="shead reveal"><h2><%= t.process %></h2><span class="rule"></span><p><%= t.process_sub %></p></div>
    <ol class="steps">
      <% (site.process || []).forEach(function(s, i){ %>
        <li class="reveal"><span class="st-ic"><%- icon(s.icon) %><i><%= i + 1 %></i></span><h3><%= tr(s.title) %></h3><p><%= tr(s.desc) %></p></li>
      <% }); %>
    </ol>
  </div>
</section>

<%- include('partials/customs', { pos: 'after_services' }) %>

<section class="sec" id="warehouses">
  <div class="wrap">
    <div class="shx reveal"><div><span class="kick"><%= t.nav_warehouses %></span><h2><%= t.warehouses_sub %></h2></div><a class="btn navy" href="<%= L('/warehouses') %>"><%= t.view_all %> <%- arrow %></a></div>
    <%- include('partials/whinfo') %>
    <p class="wh-note reveal"><%- icon('truck') %> <%= t.deliver_all %></p>
  </div>
</section>

<section class="sec navy why" id="why">
  <div class="wrap">
    <div class="shead light reveal"><h2><%= t.why %></h2><span class="rule"></span></div>
    <div class="why-grid">
      <% (site.why || []).forEach(function(w){ %><div class="why-it reveal"><span><%- icon(w.icon) %></span><p><%= tr(w.text) %></p></div><% }); %>
    </div>
  </div>
</section>



<%- include('partials/customs', { pos: 'after_sectors' }) %>

<%- include('partials/customs', { pos: 'after_jobs' }) %>

<% if (news.length) { %>
<section class="sec sky" id="news">
  <div class="wrap">
    <div class="shead reveal"><h2><%= t.news %></h2><span class="rule"></span><p><%= t.news_sub %></p></div>
    <div class="news-grid">
      <% news.forEach(function(n){ %>
        <article class="ncard reveal">
          <a class="nc-img" href="<%= L('/news/' + n.id) %>"><img src="<%= n.image || img('project') %>" alt="" loading="lazy"></a>
          <div class="nc-body"><time><%- icon('calendar') %> <%= fmtDate(n.date) %></time><h3><a href="<%= L('/news/' + n.id) %>"><%= tr(n.title) %></a></h3><p><%= tr(n.text).slice(0, 140) %><%= tr(n.text).length > 140 ? '…' : '' %></p></div>
        </article>
      <% }); %>
    </div>
    <div class="center"><a class="btn navy" href="<%= L('/news') %>"><%= t.view_all %></a></div>
  </div>
</section>
<% } %>

<% if (photos.length) { %>
<section class="sec" id="gallery">
  <div class="wrap">
    <div class="shead reveal"><h2><%= t.gallery %></h2><span class="rule"></span><p><%= t.gallery_sub %></p></div>
    <div class="pgrid" data-lightbox>
      <% photos.forEach(function(p){ %><a class="ph-it reveal" href="<%= p.file %>" data-cap="<%= tr(p.caption) %>"><img src="<%= p.file %>" alt="<%= tr(p.caption) %>" loading="lazy"></a><% }); %>
    </div>
    <div class="center"><a class="btn navy" href="<%= L('/gallery') %>"><%= t.view_all %></a></div>
  </div>
</section>
<% } %>

<% if ((site.quotes || []).length) { %>
<section class="sec sky" id="quotes">
  <div class="wrap">
    <div class="shead reveal"><h2><%= t.quotes %></h2><span class="rule"></span></div>
    <div class="quotes">
      <% site.quotes.forEach(function(q){ %><figure class="quote reveal"><blockquote><%= tr(q.text) %></blockquote><figcaption><b><%= q.name %></b><span><%= tr(q.role) %></span><% if (/^https?:\/\//.test(q.video || '')) { %><a class="q-video" href="<%= q.video %>" target="_blank" rel="noopener"><%- icon('video') %> <%= lang === 'ar' ? 'شاهد الفيديو' : 'Watch video' %></a><% } %></figcaption></figure><% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/cta', { ctaTitle: t.quote_cta_title, ctaSub: t.quote_sub }) %>

<section class="sec duo">
  <div class="wrap duo-grid">
    <div class="duo-card co reveal">
      <span class="duo-ic"><%- icon('doc') %></span>
      <h2><%= t.quote_title %></h2>
      <p><%= t.quote_sub %></p>
      <div class="duo-act">
        <a class="btn gold" href="<%= L('/quote') %>"><%= t.cta_quote %></a>
        <% if (site.profilePdf) { %><a class="btn line" href="<%= site.profilePdf %>" download><%- icon('download') %> <%= t.cta_profile %></a><% } %>
      </div>
    </div>
    <div class="duo-card wk reveal">
      <span class="duo-ic"><%- icon('store') %></span>
      <h2><%= t.home_duo_wh %></h2>
      <p><%= t.home_duo_wh_sub %></p>
      <div class="duo-act">
        <a class="btn navy" href="<%= L('/warehouses') %>"><%= t.cta_warehouses %></a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/customs', { pos: 'before_contact' }) %>

<section class="sec sky contact-sec" id="contact">
  <div class="wrap">
    <div class="shead reveal"><h2><%= t.contact_title %></h2><span class="rule"></span><p><%= t.contact_sub %></p></div>
    <div class="contact-grid">
      <%- include('partials/contactcards') %>
      <div class="form-card reveal"><%- include('partials/forms', { tab: 'quote' }) %></div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
