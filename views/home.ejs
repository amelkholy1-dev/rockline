<%- include('partials/head') %>
<%- include('partials/header') %>
<% var arrow = icon(lang === 'ar' ? 'arrow' : 'arrowr'); %>

<% var stats = (site.stats || []).filter(function(s){ return s.value; }); %>
<%- include('partials/hero/' + theme, { arrow: arrow, stats: stats }) %>

<%- include('partials/customs', { pos: 'after_hero' }) %>
<% var CA = { about: 'after_about', process: 'after_services', why: 'after_sectors', news: 'after_jobs' }; %>
<% layout.forEach(function(s){ %>
<% if (s.id === 'contact') { %><%- include('partials/customs', { pos: 'before_contact' }) %><% } %>
<% if (s.visible) { %><%- include('partials/home/' + s.id, { stats: stats }) %><% } %>
<% if (CA[s.id]) { %><%- include('partials/customs', { pos: CA[s.id] }) %><% } %>
<% }); %>

<%- include('partials/footer') %>
