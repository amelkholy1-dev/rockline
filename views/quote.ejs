<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: t.quote_title, sub: t.quote_sub }) %>
<section class="sec">
  <div class="wrap co-grid">
    <div class="form-card reveal" id="request">
      <h2><%= t.f_quote_title %></h2>
      <%- include('partials/forms', { only: 'quote', ptype: ptype }) %>
    </div>
    <div class="co-side reveal">
      <h2><%= t.process %></h2>
      <span class="rule start"></span>
      <ol class="vsteps">
        <% (site.process || []).forEach(function(s, i){ %><li><span><%= i + 1 %></span><div><h3><%= tr(s.title) %></h3><p><%= tr(s.desc) %></p></div></li><% }); %>
      </ol>
      <div class="trust">
        <div><%- icon('truck') %><span><%= t.deliver_all %></span></div>
        <% if (tr(site.contact.hours)) { %><div><%- icon('clock') %><span><%= tr(site.contact.hours) %></span></div><% } %>
        <% if (site.profilePdf) { %><a class="btn line-navy" href="<%= site.profilePdf %>" download><%- icon('download') %> <%= t.cta_profile %></a><% } %>
        <a class="btn line-navy" href="<%= L('/products') %>"><%- icon('package') %> <%= t.cta_products %></a>
      </div>
    </div>
  </div>
</section>

<section class="sec sky">
  <div class="wrap">
    <div class="shead reveal"><h2><%= t.quote_side %></h2><span class="rule"></span></div>
    <div class="why-grid light"><% (site.why || []).forEach(function(w){ %><div class="why-it reveal"><span><%- icon(w.icon) %></span><p><%= tr(w.text) %></p></div><% }); %></div>
  </div>
</section>
<%- include('partials/footer') %>
