<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: t.clients, sub: t.clients_sub }) %>
<section class="sec">
  <div class="wrap">
    <% if ((site.partners || []).length) { %>
      <% site.partners.forEach(function(g){ %>
      <div class="pgroup reveal">
        <header class="pg-head noimg">
          <div><span class="b-ic"><%- icon(g.icon || 'building') %></span><h2><%= tr(g.group) %></h2><small><%= (g.items || []).length %> <%= lang === 'ar' ? 'عميل' : 'clients' %></small></div>
        </header>
        <ul class="plist"><% (g.items || []).forEach(function(p){ %><li><span><%- icon('building') %></span><%= p %></li><% }); %></ul>
      </div>
      <% }); %>
    <% } else { %>
      <div class="empty"><%- icon('handshake') %><p><%= t.no_clients %></p></div>
    <% } %>
  </div>
</section>
<%- include('partials/cta', { ctaTitle: t.clients_cta }) %>
<%- include('partials/footer') %>
