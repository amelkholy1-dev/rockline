<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: t.partners, sub: t.partners_sub }) %>
<% var imgs = { crane: img('p_crane'), bus: img('p_bus'), truck: img('p_bus'), hotel: img('p_hotel'), restaurant: img('p_hotel') }; %>
<section class="sec">
  <div class="wrap">
    <% (site.partners || []).forEach(function(g){ %>
    <div class="pgroup reveal">
      <header class="pg-head">
        <% if (imgs[g.icon]) { %><img src="<%= imgs[g.icon] %>" alt="" loading="lazy"><% } %>
        <div><span class="b-ic"><%- icon(g.icon) %></span><h2><%= tr(g.group) %></h2><small><%= (g.items || []).length %> <%= lang === 'ar' ? 'شريك' : 'partners' %></small></div>
      </header>
      <ul class="plist"><% (g.items || []).forEach(function(p){ %><li><span><%- icon('building') %></span><%= p %></li><% }); %></ul>
    </div>
    <% }); %>
    <div class="center"><a class="btn gold" href="<%= L('/companies') %>#request"><%= t.cta_request %></a></div>
  </div>
</section>
<%- include('partials/footer') %>
