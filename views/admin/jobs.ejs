<%- include('nav') %>
<div class="pthead">
  <div><h1 class="pt">الوظائف</h1><p class="sub">كل وظيفة بتنزل على الموقع بتتحسب إعلان توظيف. متنشرش غير بعد اعتماد مديرية العمل.</p></div>
  <a class="btn navy" href="/admin/jobs/new"><%- icon('plus') %> وظيفة جديدة</a>
</div>
<% if (jobs.length) { %>
<div class="table-wrap"><table class="tbl">
  <thead><tr><th>الكود</th><th>الوظيفة</th><th class="hide-sm">الدولة</th><th class="hide-sm">العدد</th><th>الحالة</th><th></th></tr></thead>
  <tbody>
  <% jobs.forEach(function(j){ %>
    <tr>
      <td dir="ltr"><%= j.code %></td>
      <td><div class="jt"><% if (j.image) { %><img src="<%= j.image %>" alt=""><% } %><div><b><%= tr(j.title) %></b><% if (!j.approval) { %><br><small class="warn-text">من غير رقم اعتماد</small><% } %><% if ((j.fb || []).length) { %><br><a class="small" href="<%= j.fb[j.fb.length - 1].url %>" target="_blank" rel="noopener"><%- brand('facebook') %> اتنشرت على فيسبوك</a><% } %></div></div></td>
      <td class="hide-sm"><%= tr(j.country) %></td>
      <td class="hide-sm"><%= j.count %></td>
      <td><form method="post" action="/admin/jobs/<%= j.id %>/toggle"><button class="pill <%= j.active !== false ? 'on' : 'off' %>" title="اضغط للتغيير"><%= j.active !== false ? 'ظاهرة' : 'مقفولة' %></button></form></td>
      <td class="acts">
        <a class="icon-btn" href="/ar/jobs/<%= j.id %>" target="_blank" title="عرض"><%- icon('eye') %></a>
        <a class="btn xs ghost" href="/admin/jobs/<%= j.id %>/poster" title="صورة جاهزة للنشر على فيسبوك"><%- icon('image') %> صورة للنشر</a>
        <a class="icon-btn" href="/admin/jobs/<%= j.id %>/edit" title="تعديل"><%- icon('edit') %></a>
        <form method="post" action="/admin/jobs/<%= j.id %>/delete" data-confirm="متأكد إنك عايز تحذف الوظيفة دي؟"><button class="icon-btn danger" title="حذف"><%- icon('trash') %></button></form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table></div>
<% } else { %><div class="empty">مفيش وظائف لسه. <a href="/admin/jobs/new">أضف أول وظيفة</a></div><% } %>
<%- include('foot') %>
