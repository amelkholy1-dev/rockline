<%- include('nav') %>
<h2 style="margin-bottom:16px">الإعدادات</h2>
<div class="panel">
<form class="f2" method="post">
  <div class="f"><label>رقم الواتساب بكود الدولة</label><input name="whatsapp" value="<%= site.contact.whatsapp %>" dir="ltr"></div>
  <div class="f"><label>البريد الإلكتروني</label><input name="email" value="<%= site.contact.email %>" dir="ltr"></div>
  <div class="f"><label>أرقام مصر (افصل بفاصلة)</label><input name="phonesEG" value="<%= site.contact.phonesEG.join(', ') %>" dir="ltr"></div>
  <div class="f"><label>أرقام السعودية (افصل بفاصلة)</label><input name="phonesSA" value="<%= site.contact.phonesSA.join(', ') %>" dir="ltr"></div>
  <div class="f"><label>العنوان (عربي)</label><input name="address_ar" value="<%= site.contact.address.ar %>"></div>
  <div class="f"><label>Address (English)</label><input name="address_en" value="<%= site.contact.address.en %>" dir="ltr"></div>
  <div class="f"><label>مواعيد العمل (عربي)</label><input name="hours_ar" value="<%= site.contact.hours.ar %>"></div>
  <div class="f"><label>Working hours (English)</label><input name="hours_en" value="<%= site.contact.hours.en %>" dir="ltr"></div>
  <div class="f"><label>رقم الترخيص</label><input name="license" value="<%= site.brand.license %>"></div>
  <div class="f"><label>الموقع الإلكتروني</label><input name="website" value="<%= site.contact.website %>" dir="ltr"></div>
  <div class="f"><label>فيسبوك</label><input name="facebook" value="<%= site.contact.facebook %>" dir="ltr"></div>
  <div class="f"><label>إنستجرام</label><input name="instagram" value="<%= site.contact.instagram %>" dir="ltr"></div>
  <div class="f"><label>لينكدإن</label><input name="linkedin" value="<%= site.contact.linkedin %>" dir="ltr"></div>
  <div class="f"><label>تيك توك</label><input name="tiktok" value="<%= site.contact.tiktok %>" dir="ltr"></div>

  <div class="f full"><h3 style="margin-top:10px">الأرقام في الصفحة الرئيسية</h3></div>
  <% [0,1,2,3].forEach(function(i){ var s = site.stats[i] || {value:'',label:{ar:'',en:''}}; %>
    <div class="f"><label>رقم <%= i+1 %></label><input name="stat_v<%= i %>" value="<%= s.value %>"></div>
    <div class="f"><label>وصفه (عربي)</label><input name="stat_ar<%= i %>" value="<%= s.label.ar %>"></div>
    <div class="f"><label>Label (English)</label><input name="stat_en<%= i %>" value="<%= s.label.en %>" dir="ltr"></div>
  <% }); %>

  <div class="f full"><div class="warn">في الخانات اللي تحت اكتب كل بند في سطر، بالشكل ده: <b>عربي | English</b></div></div>
  <div class="f full"><label>المهن التي نوفرها</label><textarea name="professions" style="min-height:190px"><%= unpairs(site.professions) %></textarea></div>
  <div class="f full"><label>القطاعات</label><textarea name="sectors" style="min-height:120px"><%= unpairs(site.sectors) %></textarea></div>
  <div class="f full"><label>الدول (جهات السفر)</label><textarea name="countries" style="min-height:120px"><%= site.countries.map(function(c){ return (c.name.ar||'') + ' | ' + (c.name.en||''); }).join('\n') %></textarea></div>
  <div class="f full"><label>الأوراق المطلوبة للسفر</label><textarea name="docs" style="min-height:150px"><%= unpairs(site.docs) %></textarea></div>
  <div class="f full"><label>نصائح وإرشادات</label><textarea name="tips" style="min-height:150px"><%= unpairs(site.tips) %></textarea></div>
  <div class="f full"><button class="btn" type="submit">حفظ</button></div>
</form>
</div>
<%- include('foot') %>
