<%- include('nav') %>
<%
var c = site.contact || {};
var lines = String(tr(job.details) || '').split(/\n+/).map(function(x){ return x.replace(/^[\s\-•*·]+/, '').trim(); }).filter(Boolean).slice(0, 5);
var P = {
  title: tr(job.title), location: tr(job.location), dept: tr(job.dept), type: tr(job.type), exp: tr(job.exp),
  code: job.code || '', image: job.image || img('project'), hasImage: Boolean(job.image),
  logo: img('logo'), brand: tr(site.brand.short), license: site.brand.license || '',
  whatsapp: c.whatsapp || (c.phones || [])[0] || '', phones: (c.phones || []).slice(0, 2), website: c.website || '', url: jobUrl, lines: lines
};
%>
<div class="pthead">
  <div><h1 class="pt">صورة للنشر: <%= tr(job.title) %></h1><p class="sub">صورة جاهزة للفيسبوك والإنستجرام ولينكدإن والواتساب، بالشعار وبيانات الوظيفة وكود QR بيفتح صفحة الوظيفة. عدّل اللي عايزه والصورة بتتحدث لوحدها، وبعدين حمّلها وانشرها.</p></div>
  <a class="btn ghost" href="/admin/jobs"><%- icon('arrowr') %> الوظائف</a>
</div>
<div class="poster-wrap">
  <div class="card poster-view">
    <canvas id="poster" width="1080" height="1350"></canvas>
  </div>
  <form class="card form poster-ctl" id="pctl" onsubmit="return false">
    <label>المقاس
      <select name="size">
        <option value="1080x1350">بوست طولي (فيسبوك وإنستجرام) 1080×1350</option>
        <option value="1080x1080">بوست مربع 1080×1080</option>
        <option value="1080x1920">ستوري / حالة واتساب 1080×1920</option>
      </select></label>
    <label>السطر اللي فوق العنوان<input name="headline" value="انضم لفريق <%= P.brand %>"></label>
    <label>اسم الوظيفة<input name="title" value="<%= P.title %>"></label>
    <div class="grid2">
      <label>الموقع<input name="location" value="<%= P.location %>"></label>
      <label>الخبرة<input name="exp" value="<%= P.exp %>"></label>
    </div>
    <label>المميزات والشروط (كل سطر لوحده، بحد أقصى 5)<textarea name="lines" rows="5"><%= P.lines.join('\n') %></textarea></label>
    <label>رقم التقديم (واتساب)<input name="whatsapp" dir="ltr" value="<%= P.whatsapp %>"></label>
    <label class="check"><input type="checkbox" name="qr" checked> كود QR بيفتح صفحة الوظيفة على الموقع</label>
    <label class="check"><input type="checkbox" name="photo"<%= P.hasImage ? ' checked' : ' checked' %>> صورة في الخلفية<%= P.hasImage ? '' : ' (صورة الموقع، لأن الوظيفة ملهاش صورة)' %></label>
    <div class="form-foot">
      <button class="btn navy" type="button" id="dl"><%- icon('download') %> تحميل الصورة</button>
    </div>
    <hr>
    <label>نص البوست (انسخه مع الصورة)<textarea name="caption" id="caption" rows="9"></textarea></label>
    <button class="btn ghost" type="button" id="copyCap"><%- icon('copy') %> نسخ النص</button>
  </form>
</div>
<script src="/js/vendor/qrcode.js"></script>
<script>
(function () {
  var P = <%- JSON.stringify(P).replace(/</g, '\\u003c') %>;
  var cv = document.getElementById('poster'), ctx = cv.getContext('2d'), form = document.getElementById('pctl');
  var NAVY = '#203145', NAVY3 = '#152131', GOLD = '#b7a98e', GOLD2 = '#ddd3bf', WHITE = '#ffffff';
  var F = function (w, s) { return w + ' ' + s + 'px Cairo, Tahoma, sans-serif'; };
  function load(src) { return new Promise(function (r) { if (!src) return r(null); var i = new Image(); i.onload = function () { r(i); }; i.onerror = function () { r(null); }; i.src = src; }); }
  var imgs = {};
  function val(n) { var el = form.elements[n]; return el.type === 'checkbox' ? el.checked : String(el.value || '').trim(); }
  function rr(x, y, w, h, r) { ctx.beginPath(); ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r); ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath(); }
  function cover(im, x, y, w, h) { var s = Math.max(w / im.width, h / im.height), iw = im.width * s, ih = im.height * s; ctx.drawImage(im, x + (w - iw) / 2, y + (h - ih) / 2, iw, ih); }
  function wrap(text, maxW, font, maxLines) {
    ctx.font = font; var words = String(text).split(/\s+/), out = [], cur = '';
    words.forEach(function (w) { var t = cur ? cur + ' ' + w : w; if (ctx.measureText(t).width > maxW && cur) { out.push(cur); cur = w; } else cur = t; });
    if (cur) out.push(cur);
    if (out.length > maxLines) { out = out.slice(0, maxLines); out[maxLines - 1] += '…'; }
    return out;
  }
  function txt(s, x, y, font, color, align, dir) { ctx.font = font; ctx.fillStyle = color; ctx.textAlign = align || 'right'; ctx.direction = dir || 'rtl'; ctx.fillText(s, x, y); }
  function goldGrad(x0, y0, x1, y1) { var g = ctx.createLinearGradient(x0, y0, x1, y1); g.addColorStop(0, '#e6dfcf'); g.addColorStop(.5, GOLD); g.addColorStop(1, '#93836a'); return g; }

  function draw() {
    var sz = val('size').split('x'), W = +sz[0], H = +sz[1];
    cv.width = W; cv.height = H;
    var tall = H >= 1900, square = H <= 1080, M = 64, R = W - M;
    // background
    var bg = ctx.createLinearGradient(0, 0, 0, H); bg.addColorStop(0, '#2c4260'); bg.addColorStop(.45, NAVY); bg.addColorStop(1, NAVY3);
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    var photoH = square ? 430 : tall ? 900 : 620;
    if (val('photo') && imgs.photo) {
      ctx.save(); ctx.beginPath(); ctx.rect(0, 0, W, photoH); ctx.clip(); ctx.globalAlpha = P.hasImage ? 1 : .45; cover(imgs.photo, 0, 0, W, photoH); ctx.restore();
      var ov = ctx.createLinearGradient(0, 0, 0, photoH); ov.addColorStop(0, 'rgba(21,33,49,.8)'); ov.addColorStop(.3, 'rgba(21,33,49,.2)'); ov.addColorStop(.6, 'rgba(32,48,69,.45)'); ov.addColorStop(.85, 'rgba(32,48,69,.9)'); ov.addColorStop(1, '#22344b');
      ctx.fillStyle = ov; ctx.fillRect(0, 0, W, photoH);
    }
    // gold top line
    ctx.fillStyle = goldGrad(0, 0, W, 0); ctx.fillRect(0, 0, W, 10);
    // header: logo + brand
    var ly = 40, ls = square ? 104 : 120;
    if (imgs.logo) { ctx.save(); ctx.shadowColor = 'rgba(0,0,0,.35)'; ctx.shadowBlur = 16; var lw = ls * imgs.logo.width / imgs.logo.height; ctx.drawImage(imgs.logo, R - lw, ly, lw, ls); ctx.restore(); var tx = R - lw - 20; } else var tx = R;
    txt(P.brand, tx, ly + 50, F(800, 46), WHITE);
    txt('جروب للمقاولات العامة', tx, ly + 88, F(700, 26), GOLD2);
    if (P.license) txt('رقم القيد بالاتحاد المصري لمقاولي التشييد والبناء ' + P.license, tx, ly + 120, F(600, 22), 'rgba(255,255,255,.85)');
    // headline pill
    var y = photoH - (square ? 120 : 150);
    var head = val('headline');
    if (head) {
      ctx.font = F(800, 34); var pw = ctx.measureText(head).width + 56;
      rr(R - pw, y - 44, pw, 64, 32); ctx.fillStyle = goldGrad(R - pw, 0, R, 0); ctx.fill();
      txt(head, R - 28, y + 1, F(800, 34), NAVY);
    }
    // title
    var tl = wrap(val('title'), W - 2 * M, F(800, square ? 76 : 88), 2), tH = square ? 90 : 104;
    y += square ? 100 : 120;
    if (tall) y += 20;
    tl.forEach(function (l, i) { ctx.save(); ctx.shadowColor = 'rgba(0,0,0,.35)'; ctx.shadowBlur = 12; txt(l, R, y + i * tH, F(800, square ? 76 : 88), WHITE); ctx.restore(); });
    y += (tl.length - 1) * tH + 36;
    // info chips
    var chips = [['الموقع', val('location')], ['الخبرة', val('exp')], ['القسم', P.dept]].filter(function (c) { return c[1]; });
    if (chips.length) {
      var gap = 18, cw = (W - 2 * M - gap * (chips.length - 1)) / chips.length, ch = 104, cx = R;
      chips.forEach(function (c) {
        rr(cx - cw, y, cw, ch, 20); ctx.fillStyle = 'rgba(255,255,255,.08)'; ctx.fill(); ctx.strokeStyle = 'rgba(221,211,191,.55)'; ctx.lineWidth = 2; ctx.stroke();
        txt(c[0], cx - 22, y + 38, F(700, 22), GOLD2);
        var v = wrap(c[1], cw - 44, F(800, 30), 1)[0];
        txt(v, cx - 22, y + 80, F(800, 30), WHITE);
        cx -= cw + gap;
      });
      y += ch + 44;
    }
    // bullet lines
    var bl = val('lines').split(/\n+/).map(function (s) { return s.trim(); }).filter(Boolean).slice(0, square ? 3 : tall ? 6 : 5);
    var bandH = square ? 190 : 220, bandY = H - bandH;
    bl.forEach(function (l) {
      if (y + 30 > bandY - 60) return;
      ctx.beginPath(); ctx.arc(R - 12, y - 11, 11, 0, Math.PI * 2); ctx.fillStyle = GOLD; ctx.fill();
      ctx.strokeStyle = NAVY; ctx.lineWidth = 3.5; ctx.beginPath(); ctx.moveTo(R - 17, y - 11); ctx.lineTo(R - 13, y - 6); ctx.lineTo(R - 6, y - 16); ctx.stroke();
      var fs = tall ? 40 : 32;
      txt(wrap(l, W - 2 * M - 44, F(600, fs), 1)[0], R - 38, y, F(600, fs), WHITE);
      y += tall ? 78 : 54;
    });
    // legal line
    var legal = [P.code ? 'كود الوظيفة ' + P.code : '', P.type].filter(Boolean).join('   •   ');
    if (legal) txt(legal, R, bandY - 26, F(600, 22), 'rgba(255,255,255,.7)');
    // bottom band
    ctx.fillStyle = goldGrad(0, bandY, W, H); ctx.fillRect(0, bandY, W, bandH);
    var qrS = bandH - 50, qx = M, qy = bandY + 25;
    if (val('qr') && window.qrcode) {
      var q = qrcode(0, 'M'); q.addData(P.url); q.make();
      var n = q.getModuleCount(), cell = (qrS - 16) / n;
      rr(qx, qy, qrS, qrS, 14); ctx.fillStyle = WHITE; ctx.fill();
      ctx.fillStyle = NAVY;
      for (var r = 0; r < n; r++) for (var c2 = 0; c2 < n; c2++) if (q.isDark(r, c2)) ctx.fillRect(qx + 8 + c2 * cell, qy + 8 + r * cell, Math.ceil(cell), Math.ceil(cell));
    }
    txt('للتقديم ابعت على واتساب', R, bandY + (square ? 58 : 64), F(700, 30), NAVY);
    var wa = val('whatsapp');
    ctx.save(); ctx.font = F(800, square ? 54 : 60); var ww = ctx.measureText(wa).width; ctx.restore();
    txt(wa, R, bandY + (square ? 122 : 136), F(800, square ? 54 : 60), NAVY3, 'right', 'ltr');
    var sub = [P.phones.filter(function (p) { return p.replace(/\D/g, '') !== wa.replace(/\D/g, ''); })[0], P.website].filter(Boolean).join('   |   ');
    if (sub) txt(sub, R, bandY + (square ? 164 : 184), F(700, 24), 'rgba(21,33,49,.8)', 'right', 'ltr');
    updateCaption();
  }
  function updateCaption() {
    var bl = val('lines').split(/\n+/).map(function (s) { return s.trim(); }).filter(Boolean);
    var cap = [
      '📢 ' + (val('headline') || 'وظيفة متاحة'),
      '*' + val('title') + '*',
      val('location') ? '📍 الموقع: ' + val('location') : '',
      val('exp') ? '🎓 الخبرة: ' + val('exp') : '',
      bl.length ? '\n' + bl.map(function (l) { return '✔️ ' + l; }).join('\n') : '',
      '\n📲 للتقديم واتساب: ' + val('whatsapp'),
      '🔗 التفاصيل والتقديم: ' + P.url,
      '\n' + P.brand + ' جروب للمقاولات العامة',
      '\n#وظائف_مهندسين #وظائف_مقاولات #روك_لاين'
    ].filter(Boolean).join('\n');
    document.getElementById('caption').value = cap;
  }
  Promise.all([
    document.fonts ? Promise.all([document.fonts.load(F(800, 40)), document.fonts.load(F(700, 30)), document.fonts.load(F(600, 30))]).catch(function () {}) : Promise.resolve(),
    load(P.logo).then(function (i) { imgs.logo = i; }),
    load(P.image).then(function (i) { imgs.photo = i; })
  ]).then(draw);
  form.addEventListener('input', draw);
  form.addEventListener('change', draw);
  document.getElementById('dl').addEventListener('click', function () {
    cv.toBlob(function (b) {
      var a = document.createElement('a'); a.href = URL.createObjectURL(b);
      a.download = (P.code || 'job') + '-' + val('size') + '.png'; document.body.appendChild(a); a.click(); a.remove();
    }, 'image/png');
  });
  document.getElementById('copyCap').addEventListener('click', function (e) {
    var t = document.getElementById('caption'); t.select();
    (navigator.clipboard ? navigator.clipboard.writeText(t.value) : Promise.resolve(document.execCommand('copy'))).then(function () { e.target.closest('button').textContent = 'اتنسخ ✓'; });
  });
})();
</script>
<%- include('foot') %>
