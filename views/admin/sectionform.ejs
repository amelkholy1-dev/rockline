<%- include('nav') %>
<% var s = item || {}; var b = function(k, l){ return s[k] ? (s[k][l] || '') : ''; }; %>
<div class="pthead"><div><h1 class="pt"><%= item ? 'تعديل قسم' : 'قسم جديد' %></h1></div><a class="btn ghost" href="/admin/sections"><%- icon('arrowr') %> رجوع</a></div>
<form class="card form" method="post" action="/admin/sections/save" enctype="multipart/form-data">
  <input type="hidden" name="id" value="<%= s.id || '' %>">
  <div class="grid2">
    <label>العنوان (عربي) <em>*</em><input name="title_ar" value="<%= b('title','ar') %>" required></label>
    <label>العنوان (إنجليزي)<input name="title_en" dir="ltr" value="<%= b('title','en') %>"></label>
    <label class="span2">النص (عربي)<textarea name="text_ar" rows="5"><%= b('text','ar') %></textarea><small>كل فقرة في سطر.</small></label>
    <label class="span2">النص (إنجليزي)<textarea name="text_en" dir="ltr" rows="4"><%= b('text','en') %></textarea></label>
    <label>نص الزرار (عربي) - اختياري<input name="btn_ar" value="<%= b('btn','ar') %>" placeholder="مثال: قدّم الآن"></label>
    <label>نص الزرار (إنجليزي)<input name="btn_en" dir="ltr" value="<%= b('btn','en') %>"></label>
    <label class="span2">لينك الزرار<input name="link" dir="ltr" value="<%= s.link || '' %>" placeholder="/ar/projects  أو  https://..."></label>
    <label>مكان القسم في الصفحة الرئيسية
      <select name="position"><% POSITIONS.forEach(function(p){ %><option value="<%= p[0] %>"<%= s.position === p[0] ? ' selected' : '' %>><%= p[1] %></option><% }); %></select></label>
    <label>شكل الخلفية
      <select name="style">
        <option value="light"<%= s.style === 'light' ? ' selected' : '' %>>أبيض</option>
        <option value="sky"<%= s.style === 'sky' ? ' selected' : '' %>>أزرق فاتح</option>
        <option value="navy"<%= s.style === 'navy' ? ' selected' : '' %>>كحلي</option>
      </select></label>
    <div class="span2">
      <span class="lbl">صورة (اختياري)</span>
      <% if (s.image) { %><div class="thumbs"><label class="thumb"><img src="<%= s.image %>" alt=""><span><input type="checkbox" name="removeImage"> حذف الصورة</span></label></div><% } %>
      <label class="drop"><%- icon('image') %><span>اختار صورة</span><input type="file" name="image" accept="image/*" data-preview></label>
      <div class="preview"></div>
    </div>
    <label class="check span2"><input type="checkbox" name="visible"<%= !item || s.visible !== false ? ' checked' : '' %>> يظهر على الموقع</label>
  </div>
  <div class="form-foot"><button class="btn navy" type="submit"><%- icon('check') %> حفظ القسم</button><a class="btn ghost" href="/admin/sections">إلغاء</a></div>
</form>
<%- include('foot') %>
