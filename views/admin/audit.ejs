<%- include('nav') %>
<div class="pthead"><div><h1 class="pt">سجل العمليات</h1><p class="sub">كل دخول وتعديل واتخاذ قرار أمني، باسم صاحبه وعنوان جهازه. آخر 5000 عملية.</p></div></div>
<form class="card inline-form" method="get" action="/admin/audit">
  <input name="q" value="<%= q %>" placeholder="ابحث باسم أو عملية أو عنوان…">
  <button class="btn ghost" type="submit">بحث</button>
</form>
<div class="table-wrap"><table class="tbl">
  <thead><tr><th>الوقت</th><th>المستخدم</th><th>العملية</th><th class="hide-sm">تفاصيل</th><th class="hide-sm">العنوان</th></tr></thead>
  <tbody>
  <% items.forEach(function(x){ %>
    <tr><td><small><%= fmtTime(x.at) %></small></td><td><%= x.user %></td><td dir="ltr" style="text-align:start"><%= x.action %></td><td class="hide-sm"><%= x.detail %></td><td class="hide-sm" dir="ltr"><small><%= x.ip %></small></td></tr>
  <% }); %>
  <% if (!items.length) { %><tr><td colspan="5" class="muted">مفيش نتايج.</td></tr><% } %>
  </tbody>
</table></div>
<%- include('foot') %>
