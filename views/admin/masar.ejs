<%- include('nav') %>
<div class="pthead"><div><h1 class="pt">ربط مسار والتقديم</h1><p class="sub">التقديمات اللي بتيجي من الموقع (سجّل كعامل، التقديم على وظيفة، وروابط التقديم) بتنزل في «الوارد» بنظام مسار HR، وإنت بتراجعها قبل ما تدخل بنك المرشحين. دومين مسار مبيظهرش للزوار أبداً.</p></div></div>

<form class="card form" method="post" action="/admin/masar">
  <h2 class="h3"><%- icon('link') %> الاتصال بمسار</h2>
  <div class="flash <%= m.ready ? 'ok' : 'warn' %>"><%- icon(m.ready ? 'checkcircle' : 'info') %> <%= m.ready ? 'الربط متظبط. دوس «اختبار الاتصال» عشان تتأكد.' : 'الربط مش متظبط لسه: اكتب رابط مسار والمفتاح السري (نفس المفتاح اللي في إعدادات مسار على الاستضافة: MASAR_SITE_KEY).' %></div>
  <div class="grid2">
    <label>رابط نظام مسار<input name="url" dir="ltr" value="<%= m.url %>" placeholder="https://hr.nisrelkhaleeg.com"><small>الزوار مش هيشوفوه. السيرفر هو اللي بيكلّمه.</small></label>
    <label>المفتاح السري<input type="password" name="key" dir="ltr" autocomplete="new-password" placeholder="<%= m.hasKey ? '•••••••• (محفوظ — سيبه فاضي عشان يفضل زي ما هو)' : 'الصق المفتاح هنا' %>"><small>لازم يكون نفس MASAR_SITE_KEY في مسار (24 حرف على الأقل). <% if (m.keyFromEnv) { %>(مأخوذ من متغيرات البيئة)<% } %></small></label>
  </div>
  <h2 class="h3" style="margin-top:18px"><%- icon('send') %> طرق إرسال فورمات الموقع</h2>
  <p class="muted">اختار الطرق اللي عايزها تشتغل. أي طريقة تقفلها بتختفي من الموقع. (فورم «سجّل كعامل» والتقديم على الوظايف هما اللي بيروحوا مسار.)</p>
  <div class="stack-sm">
    <label class="check"><input type="checkbox" name="ch_whatsapp"<%= m.set.whatsapp !== false ? ' checked' : '' %>> <b>واتساب</b> — الزائر يبعت رسالة جاهزة على واتساب الشركة</label>
    <label class="check"><input type="checkbox" name="ch_email"<%= m.set.email !== false ? ' checked' : '' %>> <b>إيميل</b> — الرسالة توصل على إيميل الشركة (محتاج إعدادات الإيميل متظبطة)</label>
    <label class="check"><input type="checkbox" name="ch_masar"<%= m.set.masar !== false ? ' checked' : '' %>> <b>نظام مسار HR</b> — كل تسجيل عامل وتقديم وظيفة بيدخل «الوارد» في مسار</label>
  </div>
  <small class="muted">لو قفلت واتساب والإيميل، هيظهر للزائر زرار «إرسال» عادي وبتتحفظ الرسالة في «الرسائل» (وفي مسار لو شغال).</small>
  <div class="form-foot"><button class="btn navy" type="submit"><%- icon('check') %> حفظ</button></div>
</form>
<form class="card inline-form" method="post" action="/admin/masar/test">
  <p>بعد الحفظ، اختبر إن الموقع بيوصل لمسار بالمفتاح.</p>
  <button class="btn ghost" type="submit"<%= m.ready ? '' : ' disabled' %>><%- icon('link') %> اختبار الاتصال</button>
</form>

<% if (m.ready) { %>
<div class="card">
  <h2 class="h3"><%- icon('link') %> صفحات عامة جاهزة (بتتعرض من مسار على دومين الموقع)</h2>
  <ul class="muted">
    <li><b>بوابة المناديب</b> (المندوب يرفع ناسه ويتابعهم، بتدير الحسابات من مسار ← قنوات الاستقبال ← المناديب): <b dir="ltr"><%= base %>/agent</b></li>
    <li><b>متابعة الطلب برقم التقديم</b> (للمتقدم): <b dir="ltr"><%= base %>/track</b></li>
    <li><b>ملفي</b> (حساب المتقدم يعدّل بياناته): <b dir="ltr"><%= base %>/me</b></li>
  </ul>
  <small class="muted">إشعارات الإيميل من مسار (زي لما مندوب يرفع ناس) بتوصل على إيميل الشركة (إعدادات الإيميل) وعلى المستخدمين اللي مفعّلين «يوصلني إيميل بالرسائل».</small>
</div>

<div class="card">
  <h2 class="h3"><%- icon('send') %> حالة الإرسال لمسار</h2>
  <p>اتبعت بنجاح: <b><%= sent.ok %></b> &nbsp;•&nbsp; بيتحاول تاني: <b><%= sent.pending %></b> &nbsp;•&nbsp; فشل: <b><%= sent.failed %></b>
    <small class="muted"> — اللي فشل أو بيتحاول بتلاقيه في «الرسائل» وفيه زرار «إعادة الإرسال لمسار».</small></p>
</div>

<div class="card">
  <h2 class="h3"><%- icon('link') %> روابط التقديم</h2>
  <% if (linkErr) { %><div class="flash err"><%- icon('info') %> مقدرتش أجيب الروابط من مسار: <%= linkErr %></div><% } %>
  <% if (stats) { %><p class="muted">تقديمات النهارده: <b><%= stats.today %></b> • آخر 7 أيام: <b><%= stats.week %></b><% if (on === false) { %> • <span class="err-text">استقبال التقديم متوقف من مسار</span><% } %></p><% } %>
  <form class="form" method="post" action="/admin/masar/links">
    <div class="grid2">
      <label>اسم الرابط<input name="title" required placeholder="مثلاً: مطلوب ممرضين للسعودية"></label>
      <label>المصدر (مندوب أو حملة)<input name="source" placeholder="مثلاً: حملة فيسبوك"></label>
      <label>ينتهي في (اختياري)<input type="date" name="expires" dir="ltr"></label>
      <label>أقصى عدد تقديمات (0 = من غير حد)<input type="number" name="max" min="0" value="0" dir="ltr"></label>
      <label class="check span2"><input type="checkbox" name="requireCv"> السيرة الذاتية إجبارية</label>
    </div>
    <div class="form-foot"><button class="btn navy" type="submit"><%- icon('plus') %> إنشاء رابط</button></div>
  </form>
  <% if (links && links.length) { %>
  <div class="table-wrap"><table class="tbl">
    <thead><tr><th>الرابط</th><th>الحالة</th><th>التقديمات</th><th></th></tr></thead>
    <tbody>
    <% links.forEach(function(l){ var u = base + '/apply/' + l.token; %>
      <tr>
        <td><b><%= l.title %></b><br><small class="muted"><%= l.source || '' %></small><br><small dir="ltr" class="muted"><%= u %></small></td>
        <td><span class="pill <%= l.active ? 'on' : 'off' %>"><%= l.active ? 'شغال' : 'موقوف' %></span></td>
        <td><%= l.used %><%= l.max ? ' / ' + l.max : '' %></td>
        <td class="acts">
          <button class="icon-btn" type="button" title="نسخ الرابط" data-copy="<%= u %>"><%- icon('link') %></button>
          <form method="post" action="/admin/masar/links/<%= l.id %>/toggle"><input type="hidden" name="title" value="<%= l.title %>"><input type="hidden" name="source" value="<%= l.source %>"><input type="hidden" name="active" value="<%= l.active ? '0' : '1' %>"><button class="icon-btn" title="<%= l.active ? 'إيقاف' : 'تفعيل' %>"><%- icon(l.active ? 'eyeoff' : 'check') %></button></form>
          <form method="post" action="/admin/masar/links/<%= l.id %>/delete" data-confirm="حذف الرابط ده؟ هيبطّل يشتغل نهائياً."><button class="icon-btn danger" title="حذف"><%- icon('trash') %></button></form>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
  <% } else if (!linkErr) { %><div class="empty">مفيش روابط لسه.</div><% } %>
  <p class="muted" style="margin-top:12px">شكل الصفحة (صورة الغلاف، المعرض، الشروط والمزايا، نص الزرار) بتظبطه من نظام مسار نفسه: <b>الإعدادات ← رابط التقديم العام ← تعديل</b>. اللينك اللي بتبعته للناس هو اللي هنا (على دومين الموقع).</p>
</div>
<% } %>
<script>
document.querySelectorAll('[data-copy]').forEach(function (b) {
  b.addEventListener('click', function () {
    var t = b.getAttribute('data-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(t).then(function () { b.title = 'اتنسخ ✓'; });
    else { var i = document.createElement('input'); i.value = t; document.body.appendChild(i); i.select(); document.execCommand('copy'); i.remove(); b.title = 'اتنسخ ✓'; }
  });
});
</script>
<%- include('foot') %>
