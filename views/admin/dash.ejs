<%- include('nav') %>
<h1 class="pt">أهلاً <%= me.name || me.user %></h1>
<p class="sub">من هنا تتحكم في كل حاجة على الموقع. أي تعديل بيظهر على الموقع أول ما تدوس حفظ.</p>

<% if (pendingDev) { %><div class="flash warn"><%- icon('shield') %> فيه <b><%= pendingDev %></b> جهاز مستني موافقتك. <a href="/admin/security">راجعهم</a></div><% } %>
<% if (defaultPass) { %><div class="flash err"><%- icon('lock') %> لسه بتستخدم كلمة المرور الافتراضية. <a href="/admin/account">غيّرها دلوقتي</a> قبل ما ترفع الموقع.</div><% } %>
<% if (noEmail) { %><div class="flash warn"><%- icon('mail') %> حسابك ملوش إيميل، فلو نسيت كلمة المرور مش هتعرف ترجعها. <a href="/admin/account">ضيف إيميلك</a></div><% } %>
<% if (!mailReady && can('mail')) { %><div class="flash warn"><%- icon('mail') %> الإرسال بالإيميل لسه مش متظبط، فالزوار هيقدروا يبعتوا على واتساب بس. <a href="/admin/mail">اظبط الإيميل</a></div><% } %>
<% if (me.owner && typeof underCon !== 'undefined') { %>
<div class="flash <%= underCon ? 'warn' : 'ok' %>" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
  <%- icon(underCon ? 'shield' : 'checkcircle') %>
  <span style="flex:1;min-width:200px"><b>الموقع للزوار:</b>
    <%= underCon ? '🔧 تحت التطوير — الزوار يشوفوا صفحة «تحت التطوير»، وإنت (وإنت مسجّل دخول) بتشوف الموقع الحقيقي.' : '✅ ظاهر للعامة.' %></span>
  <form method="post" action="/admin/under-construction" style="margin:0">
    <input type="hidden" name="on" value="<%= underCon ? '0' : '1' %>">
    <button class="btn <%= underCon ? 'navy' : 'line-navy' %> sm" type="submit"><%= underCon ? 'اعرض الموقع للعامة' : 'حطّه تحت التطوير' %></button>
  </form>
</div>
<% } %>

<% if (me.owner) { %>
<div class="card nudge" style="border-inline-start:4px solid <%= newContent ? '#d08a1e' : '#2e8b57' %>">
  <h2 class="h3"><%- icon('sparkles') %> <%= newContent ? 'فيه محتوى جديد جاهز مع النسخة دي — لسه مطبّقتوش' : 'تحديث المحتوى من النسخة الجديدة' %></h2>
  <p class="muted" style="margin:0 0 10px">لو رفعت نسخة جديدة من الموقع ولسه بيظهر المحتوى القديم، ده عشان بيانات الموقع (النصوص والمنتجات) محفوظة لوحدها ومبتتغيرش مع رفع الكود. الزرار ده بيطبّق نصوص ومنتجات النسخة الجديدة على الموقع. بيحتفظ بالتصميم المختار والصور اللي رفعتها وإعدادات الإيميل، وبيحفظ نسخة من المحتوى القديم في فولدر <code>backups</code> جوه فولدر البيانات. <b>أي تعديل عملته على النصوص والمنتجات هيتبدل.</b></p>
  <form method="post" action="/admin/apply-defaults" data-confirm="هيتبدل محتوى الموقع (النصوص والمنتجات والمخازن) بالمحتوى الجديد اللي جاي مع النسخة. هيتحفظ نسخة من القديم. متأكد؟">
    <button class="btn <%= newContent ? 'navy' : 'ghost' %>" type="submit"><%- icon('check') %> طبّق المحتوى الجديد على الموقع</button>
  </form>
</div>
<% } %>

<% if (me.owner && (samples.site || samples.projects)) { %>
<div class="card nudge">
  <h2 class="h3"><%- icon('info') %> فيه محتوى نموذجي لازم تراجعه قبل ما تفتح الموقع للعامة</h2>
  <ul>
    <% if (samples.site) { %><li>النصوص والمنتجات وبيانات المخازن مكتوبة كنموذج مبدئي ولازم تتراجع. <a href="/admin/content/hero">راجع النصوص</a> · <a href="/admin/contact">راجع العنوان والتواصل</a>
      <form method="post" action="/admin/samples/clear" style="display:inline"><input type="hidden" name="what" value="site"><button class="btn sm ghost" type="submit">راجعتها ✓</button></form></li><% } %>
    <% if (samples.projects) { %><li><b><%= samples.projects %></b> منتج نموذجي (مكتوب عليهم «نموذج»). راجع الأقطار والأنواع والماركات الحقيقية عندكم وعدّلها، أو امسحهم وضيف منتجاتكم.
      <form method="post" action="/admin/samples/clear" style="display:inline" data-confirm="تمسح كل المنتجات النموذجية؟"><input type="hidden" name="what" value="projects"><button class="btn sm ghost" type="submit">امسح النماذج</button></form></li><% } %>
  </ul>
</div>
<% } %>
<% if (noContact && can('contact')) { %><div class="flash warn"><%- icon('phone') %> لسه مفيش أرقام تليفون ولا واتساب للشركة، فزراير الاتصال والواتساب مش ظاهرة على الموقع. <a href="/admin/contact">ضيف بيانات التواصل</a></div><% } %>

<div class="kpis">
  <% if (can('projects')) { %><a class="kpi" href="/admin/projects"><%- icon('building') %><b><%= counts.projects %></b><span>منتج ظاهر</span></a><% } %>
  <% if (can('inbox')) { %><a class="kpi" href="/admin/inbox"><%- icon('inbox') %><b><%= counts.messages %></b><span>رسالة (<%= counts.week %> الأسبوع ده)</span></a><% } %>
  <% if (can('news')) { %><a class="kpi" href="/admin/news"><%- icon('newspaper') %><b><%= counts.news %></b><span>خبر ومنشور</span></a><% } %>
</div>

<% if (can('content') && (missingStats.length || !quotesCount)) { %>
<div class="card nudge">
  <h2 class="h3"><%- icon('star') %> حاجات بتزوّد ثقة العملاء في الموقع</h2>
  <ul>
    <% missingStats.forEach(function(s){ %><li>رقم "<%= s %>" لسه فاضي ومش ظاهر. <a href="/admin/content/stats">اكتب الرقم الحقيقي</a></li><% }); %>
    <% if (!quotesCount) { %><li>مفيش آراء عملاء لسه. رأي حقيقي من عميل نفّذتوا له مشروع، ولو بفيديو، بيفرق جداً. <a href="/admin/content/quotes">ضيف رأي</a></li><% } %>
  </ul>
</div>
<% } %>

<h2 class="h2">إضافة سريعة</h2>
<div class="quick">
  <% if (can('projects')) { %><a href="/admin/projects/new"><%- icon('plus') %> منتج جديد</a><% } %>
  <% if (can('news')) { %><a href="/admin/news/new"><%- icon('plus') %> خبر أو منشور</a><% } %>
  <% if (can('gallery')) { %><a href="/admin/gallery"><%- icon('plus') %> صور للمعرض</a><% } %>
  <% if (can('images')) { %><a href="/admin/images"><%- icon('image') %> تغيير صور الصفحة الرئيسية</a><% } %>
  <% if (can('sections')) { %><a href="/admin/sections/new"><%- icon('plus') %> قسم جديد في الصفحة الرئيسية</a><% } %>
  <% if (can('contact')) { %><a href="/admin/contact"><%- icon('phone') %> تعديل الأرقام والعنوان</a><% } %>
  <% if (can('content')) { %><a href="/admin/content/warehouses"><%- icon('store') %> مخازن إضافية (اختياري)</a><% } %>
  <% if (can('content')) { %><a href="/admin/content/team"><%- icon('users') %> فريق التواصل</a><% } %>
  <% if (can('users')) { %><a href="/admin/users/new"><%- icon('user') %> إضافة مستخدم</a><% } %>
</div>

<% if (can('inbox')) { %>
<h2 class="h2">آخر الرسائل</h2>
<% if (latest.length) { %>
<div class="list">
  <% latest.forEach(function(m){ var f = m.fields || {}; %>
    <a class="row<%= m.read ? '' : ' unread' %>" href="/admin/inbox#m-<%= m.id %>">
      <span class="tag k-<%= m.kind %>"><%= KIND_LABEL[m.kind] || m.kind %></span>
      <b><%= msgTitle(f) %></b>
      <span class="muted"><%= msgLine(f) %></span>
      <span class="tag c-<%= m.channel %>"><%= CHANNEL_LABEL[m.channel] %></span>
      <time><%= fmtTime(m.at) %></time>
    </a>
  <% }); %>
</div>
<% } else { %><div class="empty">لسه مفيش رسايل. أول ما حد يبعت من الموقع هتظهر هنا.</div><% } %>
<% } %>
<%- include('foot') %>
