<%- include('nav') %>
<div class="pthead">
  <div><h1 class="pt">الرسائل</h1><p class="sub">كل اللي اتبعت من فورمات الموقع، سواء على الإيميل أو على واتساب.</p></div>
  <div class="acts">
    <form method="post" action="/admin/inbox/read-all"><button class="btn sm ghost"><%- icon('check') %> تعليم الكل كمقروء</button></form>
    <a class="btn sm ghost" href="/admin/inbox/export.csv"><%- icon('filedown') %> تصدير Excel</a>
  </div>
</div>
<div class="filters">
  <a href="/admin/inbox" class="<%= !kind ? 'on' : '' %>">الكل</a>
  <% Object.keys(KIND_LABEL).forEach(function(k){ %><a href="/admin/inbox?kind=<%= k %>" class="<%= kind === k ? 'on' : '' %>"><%= KIND_LABEL[k] %></a><% }); %>
</div>
<% if (list.length) { %>
<div class="msgs">
  <% list.forEach(function(m){ var f = m.fields || {}; var def = FORMS[m.kind] || FORMS.contact; %>
  <details class="msg<%= m.read ? '' : ' unread' %>" id="m-<%= m.id %>">
    <summary>
      <span class="tag k-<%= m.kind %>"><%= KIND_LABEL[m.kind] %></span>
      <b><%= f.company || f.name || '-' %></b>
      <span class="muted hide-sm"><%= f.trades || f.profession || (f.message || '').slice(0, 70) %></span>
      <span class="tag c-<%= m.channel %>"><%= CHANNEL_LABEL[m.channel] %><% if (m.channel === 'email' && !m.mailed) { %> (لم يصل)<% } %></span><% if (m.masar) { %> <span class="tag <%= m.masar === 'ok' ? 'c-whatsapp' : 'c-email' %>" title="الوارد في نظام مسار HR"><%= m.masar === 'ok' ? 'في مسار ✓' : m.masar === 'pending' ? 'مسار: بيتحاول' : 'مسار: فشل' %></span><% } %>
      <time><%= fmtTime(m.at) %></time>
    </summary>
    <div class="msg-body">
      <dl>
        <% def.fields.forEach(function(x){ if (f[x.k]) { %><div><dt><%= labels[x.l] %></dt><dd><%= f[x.k] %></dd></div><% } }); %>
        <% if (m.cv || m.cvUrl) { %><div><dt>السيرة الذاتية</dt><dd><a href="/admin/inbox/<%= m.id %>/cv"><%- icon('download') %> تحميل الملف</a></dd></div><% } %>
        <% if (m.consent) { %><div><dt>الموافقة</dt><dd>وافق على سياسة الخصوصية</dd></div><% } %>
        <% if (m.masar && m.masar !== 'ok') { %><div><dt>إرسال لمسار</dt><dd class="err-text"><%= m.masarError || 'لسه' %></dd></div><% } %>
        <% if (m.mailError) { %><div><dt>سبب فشل الإيميل</dt><dd class="err-text"><%= m.mailError %></dd></div><% } %>
      </dl>
      <div class="msg-acts">
        <% var phone = String(f.phone || '').replace(/[^0-9]/g, ''); if (phone) { if (phone.indexOf('0') === 0 && phone.length === 11) phone = '2' + phone; %>
          <a class="btn sm wa" href="https://wa.me/<%= phone %>" target="_blank" rel="noopener"><%- brand('whatsapp') %> رد على واتساب</a>
          <a class="btn sm ghost" href="tel:+<%= phone %>"><%- icon('phone') %> اتصال</a>
        <% } %>
        <% if (f.email) { %><a class="btn sm ghost" href="mailto:<%= f.email %>"><%- icon('mail') %> رد بالإيميل</a><% } %>
        <form method="post" action="/admin/inbox/<%= m.id %>/read"><input type="hidden" name="read" value="<%= m.read ? '0' : '1' %>"><button class="btn sm ghost"><%- icon(m.read ? 'eyeoff' : 'check') %> <%= m.read ? 'علّمها غير مقروءة' : 'تم التعامل' %></button></form>
        <% if (m.masar && m.masar !== 'ok') { %><form method="post" action="/admin/inbox/<%= m.id %>/masar"><button class="btn sm ghost"><%- icon('send') %> إعادة الإرسال لمسار</button></form><% } %>
        <form method="post" action="/admin/inbox/<%= m.id %>/delete" data-confirm="متأكد إنك عايز تحذف الرسالة دي؟"><button class="btn sm danger"><%- icon('trash') %> حذف</button></form>
      </div>
    </div>
  </details>
  <% }); %>
</div>
<% } else { %><div class="empty">مفيش رسايل هنا.</div><% } %>
<%- include('foot') %>
