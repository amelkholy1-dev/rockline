<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: t.about_title, sub: tr(site.brand.name) }) %>
<% var arrow = icon(lang === 'ar' ? 'arrow' : 'arrowr'); var b = site.brand; %>
<section class="sec">
  <div class="wrap about-grid">
    <div class="about-img reveal">
      <img src="<%= img('about') %>" alt="" width="330" height="400">
      <div class="about-seal"><img src="<%= img('logo') %>" alt=""><span><%= tr(b.short) %><b><%= b.founded ? t.founded + ' ' + b.founded : (lang === 'ar' ? 'جروب' : 'Group') %></b></span></div>
    </div>
    <div class="about-text reveal">
      <h2><%= tr(b.name) %></h2>
      <span class="rule start"></span>
      <p><%= tr(site.about.p1) %></p>
      <p><%= tr(site.about.p2) %></p>
      <% var ids = [[t.member_no, b.license], [t.grade, b.grade], [t.cr, b.cr], [t.tax, b.tax], [t.founded, b.founded]].filter(function(x){ return x[1]; }); %>
      <% if (ids.length) { %>
      <dl class="ids">
        <% if (b.license) { %><div class="wide"><dt><%- icon('shield') %></dt><dd><%= t.member %></dd></div><% } %>
        <% ids.forEach(function(x){ %><div><dt><%= x[0] %></dt><dd dir="auto"><%= x[1] %></dd></div><% }); %>
      </dl>
      <% } %>
      <div class="duo-act">
        <% if (site.profilePdf) { %><a class="btn gold" href="<%= site.profilePdf %>" download><%- icon('download') %> <%= t.cta_profile %></a><% } %>
        <a class="btn navy" href="<%= L('/products') %>"><%= t.cta_products %> <%- arrow %></a>
      </div>
    </div>
  </div>
</section>

<section class="sec sky">
  <div class="wrap vmv">
    <article class="bcard reveal"><header><span class="b-ic"><%- icon('eye') %></span><h3><%= t.vision %></h3></header><p><%= tr(site.about.vision) %></p></article>
    <article class="bcard reveal"><header><span class="b-ic"><%- icon('mission') %></span><h3><%= t.mission %></h3></header><p><%= tr(site.about.mission) %></p></article>
    <article class="bcard reveal"><header><span class="b-ic"><%- icon('diamond') %></span><h3><%= t.values %></h3></header>
      <ul class="vals"><% (site.values || []).forEach(function(v){ %><li><span><%- icon(v.icon) %></span><%= tr(v.text) %></li><% }); %></ul></article>
  </div>
</section>

<% if ((site.milestones || []).length) { %>
<section class="sec">
  <div class="wrap narrow">
    <div class="shead reveal"><h2><%= t.milestones %></h2><span class="rule"></span></div>
    <ol class="timeline">
      <% site.milestones.forEach(function(m){ %><li class="reveal"><b dir="ltr"><%= m.year %></b><div><h3><%= tr(m.title) %></h3><% if (tr(m.desc)) { %><p><%= tr(m.desc) %></p><% } %></div></li><% }); %>
    </ol>
  </div>
</section>
<% } %>

<section class="sec navy why">
  <div class="wrap">
    <div class="shead light reveal"><h2><%= t.why %></h2><span class="rule"></span></div>
    <div class="why-grid"><% (site.why || []).forEach(function(w){ %><div class="why-it reveal"><span><%- icon(w.icon) %></span><p><%= tr(w.text) %></p></div><% }); %></div>
  </div>
</section>

<% if ((site.certificates || []).length) { %>
<section class="sec sky">
  <div class="wrap"><%- include('partials/certs') %></div>
</section>
<% } %>
<%- include('partials/cta', { ctaTitle: t.quote_cta_title }) %>
<%- include('partials/footer') %>
