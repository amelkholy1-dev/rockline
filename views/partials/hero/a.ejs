<section class="hx hx-a" style="--hx:url('<%= img('hero') %>')">
  <div class="wrap"><div class="hx-in">
    <span class="kick"><%= tr(site.hero.badge) %></span>
    <h1><%= tr(site.hero.title) %></h1>
    <p><%= tr(site.hero.sub) %></p>
    <div class="hx-cta">
      <a class="btn gold lg" href="<%= L('/quote') %>"><%= t.cta_quote %> <%- arrow %></a>
      <a class="btn ghost-light lg" href="<%= L('/projects') %>"><%= t.cta_projects %></a>
    </div>
  </div></div>
</section>
<% if (stats.length) { %><section class="stx stx-a"><div class="wrap"><div class="stx-g"><% stats.forEach(function(s){ %><div class="st"><b data-count="<%= s.value %>"><%= s.value %></b><span><%= tr(s.label) %></span></div><% }); %></div></div></section><% } %>
