<div class="ccards reveal">
  <% if ((site.contact.phones||[]).length) { %>
  <div class="cc"><span class="cc-ic"><%- icon('phone') %></span><div><h3><%= t.phones %></h3><% site.contact.phones.forEach(function(p){ %><a href="<%= tel(p) %>" dir="ltr"><%= p %></a><% }); %></div></div>
  <% } %>
  <% if ((site.contact.phones2||[]).length) { %>
  <div class="cc"><span class="cc-ic"><%- icon('phone') %></span><div><h3><%= t.phones2 %></h3><% site.contact.phones2.forEach(function(p){ %><a href="<%= tel(p) %>" dir="ltr"><%= p %></a><% }); %></div></div>
  <% } %>
  <% if (hasWa) { %>
  <div class="cc wa-cc"><span class="cc-ic"><%- brand('whatsapp') %></span><div><h3><%= t.whatsapp %></h3><a href="<%= wa(t.wa_hello + ' ') %>" target="_blank" rel="noopener" dir="ltr"><%= site.contact.whatsapp %></a></div></div>
  <% } %>
  <% if (site.contact.email) { %>
  <div class="cc"><span class="cc-ic"><%- icon('mail') %></span><div><h3><%= t.email %></h3><a href="mailto:<%= site.contact.email %>" dir="ltr"><%= site.contact.email %></a></div></div>
  <% } %>
  <% if (tr(site.contact.address)) { %>
  <div class="cc wide"><span class="cc-ic"><%- icon('map') %></span><div><h3><%= t.address %></h3><a href="<%= mapUrl %>" target="_blank" rel="noopener"><%= tr(site.contact.address) %></a><% if (tr(site.contact.hours)) { %><small><%- icon('clock') %> <%= tr(site.contact.hours) %></small><% } %></div></div>
  <% } %>
  <div class="cc wide quote-cc"><span class="cc-ic"><%- icon('doc') %></span><div><h3><%= t.quote_title %></h3><p><%= lang === 'ar' ? 'ابعت تفاصيل مشروعك والرسومات من الفورم، وهنتواصل معاك لتحديد معاينة.' : 'Send your project details and drawings through the form and we will arrange a site visit.' %></p></div></div>
</div>
