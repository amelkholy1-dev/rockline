<article class="pcard reveal">
  <a class="pc-img<%= (p.images || []).length ? '' : ' ph' %>" href="<%= L('/products/' + p.id) %>" tabindex="-1" aria-hidden="true">
    <img src="<%= pimg(p) %>" alt="" loading="lazy">
    <% if (!(p.images || []).length) { %><span class="pc-ph-ic"><%- icon(catIcon(p.cat)) %></span><% } %>
  </a>
  <div class="pc-body">
    <% if (p.cat) { %><span class="pc-cat"><%- icon(catIcon(p.cat)) %> <%= cat(p.cat) %></span><% } %>
    <h3><a href="<%= L('/products/' + p.id) %>"><%= tr(p.title) %></a></h3>
    <ul class="pc-meta">
      <% if (tr(p.pack)) { %><li><%- icon('package') %><%= tr(p.pack) %></li><% } %>
    </ul>
    <a class="btn gold sm" href="<%= L('/quote?type=' + encodeURIComponent(cat(p.cat))) %>"><%- icon('doc') %> <%= t.cta_quote %></a>
  </div>
</article>
