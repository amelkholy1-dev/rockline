<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: t.jobs_title, sub: t.jobs_sub }) %>

<section class="sec">
  <div class="wrap">
    <form class="jfilter" method="get" action="<%= L('/jobs') %>" role="search">
      <label class="jf-q"><%- icon('search') %><input type="search" name="q" value="<%= q %>" placeholder="<%= t.search %>" aria-label="<%= t.search %>"></label>
      <% if (jobLocations.length) { %><select name="location" aria-label="<%= t.location %>"><option value=""><%= t.all_locations %></option><% jobLocations.forEach(function(c){ %><option<%= c === loc ? ' selected' : '' %>><%= c %></option><% }); %></select><% } %>
      <% if (jobDepts.length) { %><select name="dept" aria-label="<%= t.dept %>"><option value=""><%= t.all_depts %></option><% jobDepts.forEach(function(c){ %><option<%= c === dept ? ' selected' : '' %>><%= c %></option><% }); %></select><% } %>
      <button class="btn navy" type="submit"><%= t.filter %></button>
      <% if (q || loc || dept) { %><a class="btn line-navy" href="<%= L('/jobs') %>"><%= t.clear %></a><% } %>
    </form>

    <% if (jobs.length) { %>
      <div class="jobs-grid"><% jobs.forEach(function(j){ %><%- include('partials/jobcard', { j: j }) %><% }); %></div>
    <% } else { %>
      <div class="empty"><%- icon('hardhat') %><p><%= t.no_jobs %></p><a class="btn gold" href="<%= L('/apply') %>"><%= t.send_cv %></a></div>
    <% } %>
    <div class="note-card"><%- icon('doc') %><p><%= lang === 'ar' ? 'مش لاقي وظيفة مناسبة؟ ابعت سيرتك الذاتية وهنحتفظ بيها ونتواصل معاك أول ما تتاح فرصة.' : 'No suitable role? Send us your CV and we will keep it on file and contact you when a role opens.' %> <a href="<%= L('/apply') %>"><b><%= t.send_cv %></b></a></p></div>
  </div>
</section>
<%- include('partials/footer') %>
