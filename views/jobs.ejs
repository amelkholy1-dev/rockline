<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/pagehead', { heading: t.jobs_title, sub: t.jobs_sub }) %>

<section class="sec">
  <div class="wrap">
    <form class="jfilter" method="get" action="<%= L('/jobs') %>" role="search">
      <label class="jf-q"><%- icon('search') %><input type="search" name="q" value="<%= q %>" placeholder="<%= t.search %>" aria-label="<%= t.search %>"></label>
      <% if (jobCountries.length) { %><select name="country" aria-label="<%= t.country %>"><option value=""><%= t.all_countries %></option><% jobCountries.forEach(function(c){ %><option<%= c === country ? ' selected' : '' %>><%= c %></option><% }); %></select><% } %>
      <% if (jobSectors.length) { %><select name="sector" aria-label="<%= t.sector %>"><option value=""><%= t.all_sectors %></option><% jobSectors.forEach(function(c){ %><option<%= c === sector ? ' selected' : '' %>><%= c %></option><% }); %></select><% } %>
      <button class="btn navy" type="submit"><%= t.filter %></button>
      <% if (q || country || sector) { %><a class="btn line-navy" href="<%= L('/jobs') %>"><%= t.clear %></a><% } %>
    </form>

    <% if (jobs.length) { %>
      <div class="jobs-grid"><% jobs.forEach(function(j){ %><%- include('partials/jobcard', { j: j }) %><% }); %></div>
    <% } else { %>
      <div class="empty"><%- icon('briefcase') %><p><%= t.no_jobs %></p><a class="btn gold" href="<%= L('/apply') %>"><%= t.cta_register %></a></div>
    <% } %>
    <div class="note-card"><%- icon('info') %><p><%= t.legal_note %></p></div>
  </div>
</section>
<%- include('partials/footer') %>
